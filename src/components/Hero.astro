---
import { site } from "../data/site";
---

<section class="hero" id="inicio">
  <div class="curtain-light" aria-hidden="true"></div>

  <!-- El h1 existe para buscadores y lectores de pantalla; visualmente habla el ensō -->
  <h1 class="sr-only">{site.name} · Hatha Yoga en {site.location}</h1>

  <!-- Ensō: el círculo zen dibujado en un solo trazo -->
  <svg viewBox="0 0 200 200" class="enso" aria-hidden="true">
    <defs>
      <filter id="brush">
        <feTurbulence type="fractalNoise" baseFrequency="0.9" numOctaves="2" result="noise" />
        <feDisplacementMap in="SourceGraphic" in2="noise" scale="3" />
      </filter>
    </defs>
    <path
      class="enso__stroke"
      filter="url(#brush)"
      d="M 128 32 C 170 48 184 96 168 134 C 150 176 96 186 60 164 C 26 142 20 92 44 60 C 62 36 92 26 116 30"
    />
  </svg>

  <div class="hero__actions">
    <a href="#contacto" class="btn btn--solid">Reservá tu clase</a>
    <a href="#clases" class="btn btn--ghost">Ver clases</a>
  </div>

  <p class="vertical vertical--hero" aria-hidden="true">静けさの中で</p>

  <a href="#filosofia" class="hero__scroll" aria-label="Seguir bajando"><span></span></a>
</section>

<style>
  .hero {
    position: relative;
    min-height: 100vh;
    min-height: 100svh;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: clamp(2.5rem, 6vh, 4rem);
    padding: 7rem var(--gutter) 6rem;
    overflow: hidden;
    background: linear-gradient(180deg, var(--washi) 0%, var(--linen) 100%);
  }

  .enso {
    position: relative;
    z-index: 1;
    width: min(48vh, 72vw, 440px);
    height: auto;
    overflow: visible;
  }

  .enso__stroke {
    fill: none;
    stroke: var(--ink);
    stroke-width: 7;
    stroke-linecap: round;
    opacity: .85;
    stroke-dasharray: 560;
    stroke-dashoffset: 560;
    animation: draw 3.2s var(--ease) .6s forwards;
  }

  @keyframes draw { to { stroke-dashoffset: 0; } }

  /* Los botones aparecen cuando el trazo está por cerrarse */
  .hero__actions {
    position: relative;
    z-index: 2;
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 1rem;
    animation: rise 1.4s var(--ease) 2.8s both;
  }

  @keyframes rise {
    from { opacity: 0; transform: translateY(12px); }
    to   { opacity: 1; transform: none; }
  }

  .vertical--hero {
    position: absolute;
    right: var(--gutter);
    top: 50%;
    transform: translateY(-50%);
    font-size: .95rem;
    z-index: 2;
  }

  .hero__scroll {
    position: absolute;
    left: 50%;
    bottom: 2rem;
    width: 1px;
    height: 56px;
    background: rgba(46, 42, 37, .12);
    overflow: hidden;
  }
  .hero__scroll span {
    position: absolute;
    inset: 0;
    background: var(--ink);
    animation: drip 2.6s var(--ease) infinite;
  }
  @keyframes drip {
    0%   { transform: translateY(-100%); }
    60%  { transform: translateY(100%); }
    100% { transform: translateY(100%); }
  }

  @media (max-width: 720px) {
    .vertical--hero { right: .75rem; font-size: .8rem; }
  }

  @media (prefers-reduced-motion: reduce) {
    .enso__stroke { stroke-dashoffset: 0; }
  }
</style>
