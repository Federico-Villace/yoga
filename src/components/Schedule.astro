---
import { schedule } from "../data/site";
---

<section class="schedule" id="horarios">
  <header class="section-head">
    <p class="eyebrow reveal">Horarios</p>
    <h2 class="section-title reveal">La semana</h2>
  </header>

  <ul class="timetable reveal">
    {schedule.map((s) => (
      <li>
        <div class="row">
          <span class="day">{s.day}</span>
          <span class="dots"></span>
          <span class="time">{s.start} — {s.end}</span>
        </div>
        <p class="detail">
          {s.name} · en{" "}
          <a href={s.venue.href} target="_blank" rel="noopener noreferrer">{s.venue.name}</a>
        </p>
      </li>
    ))}
  </ul>
  <p class="schedule__note reveal">Clases privadas y en domicilio: horario a coordinar.</p>
</section>

<style>
  .schedule {
    max-width: 52rem;
    margin: 0 auto;
    padding: var(--section) var(--gutter);
  }

  .timetable { list-style: none; }
  .timetable li {
    padding: 1.6rem 0;
    border-bottom: 1px solid var(--sand);
  }
  .timetable li:first-child { border-top: 1px solid var(--sand); }

  .row { display: flex; align-items: baseline; gap: 1rem; }

  .day { font-family: var(--serif); font-size: 1.3rem; min-width: 7rem; }
  .dots { flex: 1; border-bottom: 1px dotted var(--sand); transform: translateY(-.3rem); }
  .time { font-family: var(--serif); font-size: 1.2rem; letter-spacing: .04em; }

  .detail {
    margin-top: .35rem;
    font-size: .85rem;
    letter-spacing: .08em;
    color: var(--stone);
  }
  .detail a {
    color: var(--oak);
    border-bottom: 1px solid transparent;
    transition: border-color .4s var(--ease);
  }
  .detail a:hover { border-color: var(--oak); }

  .schedule__note {
    margin-top: 2rem;
    text-align: center;
    font-size: .85rem;
    letter-spacing: .1em;
    color: var(--stone);
  }

  @media (max-width: 720px) {
    .row { flex-wrap: wrap; gap: .25rem; }
    .dots { display: none; }
    .day { min-width: 0; width: 100%; }
  }
</style>
